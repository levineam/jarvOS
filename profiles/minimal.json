{
  "schemaVersion": "jarvos.profile.v1",
  "id": "minimal",
  "title": "Minimal",
  "description": "Portable jarvOS starter workspace with core files, a dormant runtime declaration, agent-context, and the public control-plane module. A Vault remains optional until explicitly activated.",
  "public": true,
  "required": [
    "node",
    "workspace",
    "config-schema",
    "agent-context",
    "control-plane"
  ],
  "optional": [],
  "writes": [
    "core-files",
    "jarvos.config.json"
  ],
  "doctorChecks": [
    "node-version",
    "workspace-files",
    "config-schema",
    "vault-path",
    "vault-path-stale",
    "journal-conflict",
    "agent-context-package",
    "control-plane-module",
    "compound-engineering-provider"
  ]
}
