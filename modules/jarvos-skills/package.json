{
  "name": "@jarvos/skills",
  "version": "0.3.0",
  "description": "Portable jarvOS operating-system skills and default experience packs for compatible agent runtimes.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "dependencies": {
    "@jarvos/runtime-kit": "file:../jarvos-runtime-kit"
  },
  "bundledDependencies": [
    "@jarvos/runtime-kit"
  ],
  "bin": {
    "jarvos-skills": "scripts/install-skills.js",
    "jarvos-skills-scheduled-repair": "scripts/scheduled-repair.js"
  },
  "files": [
    "README.md",
    "manifest.json",
    "packs/",
    "src/",
    "scripts/",
    "skills/",
    "docs/",
    "schemas/"
  ],
  "scripts": {
    "prepack": "node scripts/bundle-runtime-kit.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
