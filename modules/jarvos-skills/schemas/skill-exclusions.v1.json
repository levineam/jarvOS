{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvos.skill-exclusions/v1",
  "title": "jarvOS owner skill exclusion overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "jarvos.skill-exclusions/v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logicalId", "reasonCode", "excludedAt"],
        "properties": {
          "logicalId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1
          },
          "excludedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
