{
  "bundle": "operating-system-skills",
  "version": "0.1.0",
  "description": "Default jarvOS skill bundle for planning, rule wiring, context hygiene, and cron safety.",
  "defaultSkills": [
    "workflow-execution",
    "rule-creation",
    "context-management",
    "cron-hygiene"
  ],
  "optionalAdapters": [
    {
      "name": "qmd",
      "type": "markdown-search",
      "default": false,
      "docs": "docs/qmd-adapter.md",
      "reason": "QMD is underlying markdown-search software, not a default jarvOS operating-system skill."
    }
  ],
  "managedProviders": [
    {
      "id": "compound-engineering",
      "manifest": "../jarvos-coding/providers/compound-engineering.json",
      "distribution": "managed-external",
      "default": true,
      "updatePolicy": "managed-release",
      "activation": "harness-specific-approved-pin"
    }
  ],
  "skills": [
    {
      "name": "workflow-execution",
      "path": "skills/workflow-execution/SKILL.md",
      "purpose": "Plan, track, package, execute, and verify non-trivial work.",
