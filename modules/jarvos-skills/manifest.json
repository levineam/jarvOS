{
  "bundle": "operating-system-skills",
  "version": "0.1.0",
  "description": "Default jarvOS skill bundle for planning, rule wiring, context hygiene, and cron safety.",
  "defaultSkills": [
    "workflow-execution",
    "rule-creation",
    "context-management",
    "cron-hygiene"
  ],
  "optionalAdapters": [
    {
      "name": "qmd",
      "type": "markdown-search",
      "default": false,
      "docs": "docs/qmd-adapter.md",
      "reason": "QMD is underlying markdown-search software, not a default jarvOS operating-system skill."
    }
  ],
  "managedProviders": [
    {
      "id": "compound-engineering",
      "manifest": "../jarvos-coding/providers/compound-engineering.json",
      "distribution": "managed-external",
      "default": true,
      "updatePolicy": "managed-release",
      "activation": "harness-specific-approved-pin"
    }
  ],
  "skills": [
    {
      "name": "workflow-execution",
      "path": "skills/workflow-execution/SKILL.md",
      "purpose": "Plan, accept, work, finish, inspect, and resume jarvOS-managed coding runs.",
      "source": {
        "revision": "jarvos-skills-v0.3.0",
        "digest": "da13d968a2305dfe44c49f40fd21d2e2fae13a1a6036432d8b0d44a6ff5775d3",
        "license": "MIT",
        "provenance": "jarvOS reviewed source"
      },
      "supportedHarnesses": ["generic", "codex", "hermes"],
      "projection": {
        "mode": "copy",
        "targets": {
          "generic": { "path": "{skillsRoot}/workflow-execution/SKILL.md", "renderer": "raw-skill-md" },
          "codex": { "path": "{skillsRoot}/workflow-execution/SKILL.md", "renderer": "raw-skill-md" },
          "hermes": { "path": "{skillsRoot}/workflow-execution/SKILL.md", "renderer": "raw-skill-md" }
