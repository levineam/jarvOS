{
  "name": "jarvos-secondbrain",
  "version": "1.0.0",
  "description": "JarvOS secondbrain monorepo — journal, notes, and bridge packages",
  "private": true,
  "workspaces": [
    "packages/jarvos-ambient",
    "packages/jarvos-secondbrain-journal",
    "packages/jarvos-secondbrain-notes",
    "packages/jarvos-secondbrain-wiki",
    "packages/jarvos-secondbrain-projects"
  ],
  "scripts": {
    "onboard:shared-vault": "node bridge/config/src/shared-vault-onboarding.js",
    "maintain:journal-backlinks": "node scripts/journal-backlink-recovery.js",
    "maintain:vault-mutations": "node scripts/vault-mutation-reconcile.js",
    "health:vault-mutations": "node scripts/vault-mutation-health.js",
    "test:obsidian-live": "node scripts/obsidian-live-smoke.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
