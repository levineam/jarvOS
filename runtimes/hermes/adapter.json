{
  "schemaVersion": 1,
  "id": "hermes",
  "displayName": "Hermes Agent",
  "capabilityDescriptor": {
    "version": "jarvos-runtime-capability-descriptor.v1", "harness": "hermes",
    "capabilities": {
      "context": { "currentWork": { "status": "supported", "transport": "jarvos MCP", "evidence": "sharedAgentContext required tools" }, "recall": { "status": "supported", "transport": "jarvos MCP", "evidence": "sharedAgentContext required tools" }, "startupHydration": { "status": "supported", "transport": "Hermes on_session_start + pre_llm_call plugin hooks", "evidence": "plugins/jarvos-context/__init__.py" } },
      "notes": { "create": { "status": "supported", "transport": "jarvos_create_note MCP tool", "evidence": "sharedAgentContext required tools" }, "read": { "status": "unsupported", "reason": "No public Hermes note-read bridge is declared." }, "update": { "status": "unsupported", "reason": "No public Hermes note-update bridge is declared." }, "journalLink": { "status": "unsupported", "reason": "No public Hermes journal-link bridge is declared." } },
      "skills": { "discover": { "status": "manual", "transport": "Hermes skill directory", "reason": "The public adapter installs guidance but does not claim skill discovery integration." }, "invoke": { "status": "manual", "transport": "Hermes skill directory", "reason": "Hermes owns skill invocation." } },
      "toolAuthorization": { "declare": { "status": "unsupported", "reason": "No public Hermes authorization contract is installed." }, "enforce": { "status": "unsupported", "reason": "Hermes owns tool authorization." } },
      "egress": { "declare": { "status": "unsupported", "reason": "No public Hermes egress declaration is installed." }, "enforce": { "status": "unsupported", "reason": "Hermes owns egress enforcement." } },
      "session": { "startupHook": { "status": "supported", "transport": "Hermes on_session_start + pre_llm_call plugin hooks", "evidence": "plugins/jarvos-context/__init__.py" }, "handoff": { "status": "unsupported", "reason": "No public Hermes handoff adapter is declared." } },
      "inboundDispatch": { "receive": { "status": "unsupported", "reason": "No public Hermes inbound dispatch bridge is declared." }, "validate": { "status": "unsupported", "reason": "No public Hermes inbound dispatch bridge is declared." } },
      "lifecycle": { "receipt": { "status": "unsupported", "reason": "No public Hermes lifecycle receipt bridge is declared." } },
      "scheduledWork": { "participate": { "status": "unsupported", "reason": "Hermes scheduling remains host-native." } },
      "codingEntrypoint": { "invoke": { "status": "unsupported", "reason": "Hermes is not declared as a jarvOS coding entrypoint." } }
    }
  },
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate"
    ]
  },
  "targets": [
    {
      "id": "hermes-agent",
      "kind": "agent-runtime",
      "mcp": {
        "supported": true,
        "transport": "stdio",
        "registration": "hermes mcp add jarvos --command node --args <mcp-server>",
        "verification": "hermes mcp test jarvos"
      },
      "hydration": {
        "mode": "hook",
        "event": "on_session_start + pre_llm_call",
        "script": "plugins/jarvos-context/__init__.py",
        "defaultMaxChars": 6000,
        "fallback": "Call the jarvos_hydrate MCP tool at session start if the plugin is not installed or enabled."
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "paths": [
      "~/.hermes/config.yaml",
      "~/.hermes/skills/jarvos/SKILL.md"
    ]
  },
  "unsupportedCapabilities": [],
  "verification": [
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check hermes"
  ]
}
