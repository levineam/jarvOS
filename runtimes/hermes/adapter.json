{
  "schemaVersion": 1,
  "id": "hermes",
  "displayName": "Hermes Agent",
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate"
    ]
  },
  "targets": [
    {
      "id": "hermes-agent",
      "kind": "agent-runtime",
      "mcp": {
        "supported": true,
        "transport": "stdio",
        "registration": "hermes mcp add jarvos --command node --args <mcp-server>",
        "verification": "hermes mcp test jarvos"
      },
      "hydration": {
        "mode": "manual",
        "command": "Call the jarvos_hydrate MCP tool at session start.",
        "reason": "Hermes exposes MCP registration, but this adapter does not claim an automatic startup hook until the native hook contract is verified."
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "stewardshipAdapter": {
    "version": "jarvos-stewardship-adapter.v1",
    "harness": "hermes",
    "isolation": {
      "preferredMode": "managed-launcher",
      "fallbackMode": "managed-launcher",
      "providesIsolatedWorktrees": true,
      "requiresVerifiedWorktreeEvidence": true
    },
    "activation": {
      "enabledByDefault": false,
      "reason": "Configured managed roots activate the reversible launcher; all other repositories and administrative commands stay on the bound original binary."
    },
    "bootstrap": {
      "version": "jarvos-stewardship-bootstrap.v1",
      "harness": "hermes",
      "rootEnvironment": "JARVOS_STEWARDSHIP_STABLE_ROOT",
      "dispatcher": "jarvos-stewardship-dispatcher",
      "entrypoint": { "kind": "hermesShell", "path": "jarvos-hermes-pre-llm-hook.js" },
      "actions": ["harness-launch", "session-start", "session-turn", "bridge", "provenance-probe"],
      "selectedRuntimeAssets": ["runtimes/hermes/jarvos-pre-llm-hook.js"],
      "installedConfig": { "inspection": "stable-entrypoint-only", "prepare": "reversible", "rollback": "exact-owned-state" },
      "provenance": { "action": "provenance-probe", "sideEffectFree": true }
    },
    "bridge": {
      "environment": "JARVOS_STEWARDSHIP_BRIDGE_COMMAND",
      "contract": "An executable on PATH accepts one lifecycle capability name and emits a public-safe JSON availability receipt."
    },
    "capabilities": {
      "startOrResume": { "mode": "managed-launcher" },
      "heartbeat": { "mode": "managed-launcher" },
      "checkpoint": { "mode": "managed-launcher", "state": "stable-idle" },
      "stop": { "mode": "managed-launcher" },
      "nextTurnInput": { "mode": "native-hook", "event": "pre_llm_call", "script": "jarvos-hermes-pre-llm-hook.js", "reason": "The stable shell is recorded in Hermes's exact allowlist with its immutable mtime." },
      "availability": { "mode": "managed-launcher" }
    }
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "transactionalPreserveUnrelatedConfiguration": true,
    "paths": [
      "~/.hermes/config.yaml",
      "~/.hermes/shell-hooks-allowlist.json",
      "~/.hermes/skills/jarvos/SKILL.md"
    ]
  },
  "unsupportedCapabilities": [
    {
      "capability": "automatic-startup-hydration",
      "reason": "Hermes MCP registration is supported; automatic startup hydration remains deferred until the native startup hook surface is verified."
    }
  ],
  "verification": [
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check hermes"
  ]
}
