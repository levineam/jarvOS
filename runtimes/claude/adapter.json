{
  "schemaVersion": 1,
  "id": "claude",
  "displayName": "Claude",
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate"
    ]
  },
  "targets": [
    {
      "id": "claude-code",
      "kind": "cli",
      "mcp": {
        "supported": true,
        "registration": "claude mcp add --scope user jarvos -- node <mcp-server>"
      },
      "hydration": {
        "mode": "hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js",
        "defaultMaxChars": 9500
      },
      "bootstrap": {
        "claudeMd": {
          "template": "templates/CLAUDE.md.template",
          "target": "~/.claude/CLAUDE.md",
          "idempotent": true,
          "preservesLocalExtensionsBelow": "<!-- LOCAL-EXTENSIONS-BELOW -->",
          "skipEnv": "JARVOS_SKIP_CLAUDE_MD"
        }
      }
    },
    {
      "id": "claude-desktop",
      "kind": "desktop",
      "mcp": {
        "supported": true,
        "registration": "mcpServers.jarvos in Claude Desktop config"
      },
      "hydration": {
        "mode": "manual",
        "reason": "Claude Desktop local MCP config does not provide a verified startup additional-context hook in this v1 adapter."
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "stewardshipAdapter": {
    "version": "jarvos-stewardship-adapter.v1",
    "harness": "claude-code",
    "isolation": {
      "preferredMode": "native",
      "fallbackMode": "managed-launcher",
      "providesIsolatedWorktrees": true,
      "requiresVerifiedWorktreeEvidence": true
    },
    "activation": {
      "enabledByDefault": false,
      "reason": "The lifecycle hooks are packaged for opt-in activation and do not modify user configuration by this declaration."
    },
    "bridge": {
      "environment": "JARVOS_STEWARDSHIP_BRIDGE_COMMAND",
      "contract": "An executable on PATH accepts one lifecycle capability name and emits a public-safe JSON availability receipt. For nextTurnInput, a pending receipt may contain only a bounded plain-English prompt, 2-3 choices, a listed default, and an opaque correlation identifier; hooks display it without granting authority."
    },
    "capabilities": {
      "startOrResume": {
        "mode": "native-hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js"
      },
      "heartbeat": {
        "mode": "native-hook",
        "event": "UserPromptSubmit",
        "script": "jarvos-session-turn-hook.js"
      },
      "checkpoint": {
        "mode": "managed-launcher",
        "state": "stable-idle",
        "reason": "Checkpointing remains a managed-launcher responsibility until an enabled bridge is configured."
      },
      "stop": {
        "mode": "managed-launcher",
        "reason": "Stopping remains a managed-launcher responsibility until an enabled bridge is configured."
      },
      "nextTurnInput": {
        "mode": "native-hook",
        "event": "UserPromptSubmit",
        "script": "jarvos-session-turn-hook.js"
      },
      "availability": {
        "mode": "native-hook",
        "script": "jarvos-session-turn-hook.js"
      }
    }
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "paths": [
      "~/.claude/settings.json",
      "~/.claude/CLAUDE.md",
      "~/Library/Application Support/Claude/claude_desktop_config.json"
    ]
  },
  "unsupportedCapabilities": [
    {
      "capability": "claude-desktop-startup-hydration",
      "reason": "Desktop startup context injection is not enabled until an official supported hook surface is verified."
    }
  ],
  "verification": [
    "claude mcp get jarvos",
    "node runtimes/claude/jarvos-session-start-hook.js",
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check claude"
  ]
}
