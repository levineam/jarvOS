{
  "schemaVersion": 1,
  "id": "claude",
  "displayName": "Claude",
  "skillProjection": {
    "version": "jarvos-skill-projection-adapter/v1",
    "managedRoot": "~/.claude/skills",
    "orderedScopes": [
      "project",
      "user",
      "managed"
    ],
    "scopeRoots": {
      "project": "./.claude/skills",
      "user": "~/.claude/skills"
    },
    "renderer": "raw-skill-bundle",
    "verificationTier": "interactive-smoke",
    "bundleAllowlist": [
      "SKILL.md",
      "scripts/**",
      "assets/**",
      "references/**",
      "templates/**"
    ],
    "alias": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64,
      "reservedNames": []
    },
    "probeIsolation": {
      "mode": "interactive-secret-free-smoke",
      "unattended": false
    }
  },
  "operatorNotification": {
    "version": "jarvos-operator-notification-adapter/v1",
    "contract": "jarvos-operator-notification/v1",
    "delivery": {
      "status": "not-configured",
      "reason": "Local owner configuration chooses a delivery surface; this public adapter does not configure one."
    }
  },
  "capabilityDescriptor": {
    "version": "jarvos-runtime-capability-descriptor.v1",
    "harness": "claude",
    "capabilities": {
      "context": {
        "currentWork": {
          "status": "supported",
          "transport": "jarvos MCP",
          "evidence": "sharedAgentContext required tools"
        },
        "recall": {
          "status": "supported",
          "transport": "jarvos MCP",
          "evidence": "sharedAgentContext required tools"
        },
        "startupHydration": {
          "status": "supported",
          "transport": "Claude Code SessionStart hook",
          "evidence": "jarvos-session-start-hook.js"
        }
      },
      "notes": {
        "create": {
          "status": "supported",
          "transport": "jarvos_create_note MCP tool",
          "evidence": "sharedAgentContext required tools"
        },
        "read": {
          "status": "unsupported",
          "reason": "No public Claude note-read bridge is declared."
        },
        "update": {
          "status": "unsupported",
          "reason": "No public Claude note-update bridge is declared."
        },
        "journalLink": {
          "status": "unsupported",
          "reason": "No public Claude journal-link bridge is declared."
        }
      },
      "skills": {
        "discover": {
          "status": "manual",
          "transport": "Claude skill directory",
          "reason": "Claude owns skill discovery."
        },
        "invoke": {
          "status": "manual",
          "transport": "Claude skill directory",
          "reason": "Claude owns skill invocation."
        }
      },
      "toolAuthorization": {
        "declare": {
          "status": "unsupported",
          "reason": "No public Claude authorization contract is installed."
        },
        "enforce": {
          "status": "unsupported",
          "reason": "Claude owns tool authorization."
        }
      },
      "egress": {
        "declare": {
          "status": "unsupported",
          "reason": "No public Claude egress declaration is installed."
        },
        "enforce": {
          "status": "unsupported",
          "reason": "Claude owns egress enforcement."
        }
      },
      "session": {
        "startupHook": {
          "status": "supported",
          "transport": "Claude Code SessionStart hook",
          "evidence": "jarvos-session-start-hook.js"
        },
        "handoff": {
          "status": "unsupported",
          "reason": "No public Claude handoff adapter is declared."
        },
        "preCompactHook": {
          "status": "supported",
          "transport": "Claude Code PreCompact hook",
          "evidence": "jarvos-precompact-hook.js",
          "reason": "Registered on unmanaged installs. The stewardship dispatcher v1 action ABI carries no compaction action, so a managed install registers no PreCompact hook rather than route a block/allow channel through an action the dispatcher rejects."
        }
      },
      "inboundDispatch": {
        "receive": {
          "status": "unsupported",
          "reason": "No public Claude inbound dispatch bridge is declared."
        },
        "validate": {
          "status": "unsupported",
          "reason": "No public Claude inbound dispatch bridge is declared."
        }
      },
      "lifecycle": {
        "receipt": {
          "status": "unsupported",
          "reason": "No public Claude lifecycle receipt bridge is declared."
        }
      },
      "scheduledWork": {
        "participate": {
          "status": "unsupported",
          "reason": "Scheduled work is not part of this public adapter."
        }
      },
      "codingEntrypoint": {
        "invoke": {
          "status": "supported",
          "transport": "Claude Code CLI",
          "evidence": "public Claude Code adapter"
        }
      }
    }
  },
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate"
    ]
  },
  "targets": [
    {
      "id": "claude-code",
      "kind": "cli",
      "mcp": {
        "supported": true,
        "registration": "claude mcp add --scope user jarvos -- node <mcp-server>"
      },
      "hydration": {
        "mode": "hook",
        "event": "SessionStart",
        "matcher": "startup|resume|compact",
        "script": "jarvos-session-start-hook.js",
        "defaultMaxChars": 9500,
        "reorientMaxChars": 4000
      },
      "precompact": {
        "mode": "hook",
        "event": "PreCompact",
        "script": "jarvos-precompact-hook.js"
      },
      "bootstrap": {
        "claudeMd": {
          "template": "templates/CLAUDE.md.template",
          "target": "~/.claude/CLAUDE.md",
          "idempotent": true,
          "preservesLocalExtensionsBelow": "<!-- LOCAL-EXTENSIONS-BELOW -->",
          "skipEnv": "JARVOS_SKIP_CLAUDE_MD"
        }
      }
    },
    {
      "id": "claude-desktop",
      "kind": "desktop",
      "mcp": {
        "supported": true,
        "registration": "mcpServers.jarvos in Claude Desktop config"
      },
      "hydration": {
        "mode": "manual",
        "reason": "Claude Desktop local MCP config does not provide a verified startup additional-context hook in this v1 adapter."
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "managedActivation": {
    "version": "jarvos-managed-activation/v1",
    "harness": "claude",
    "executionOwner": "native-hooks",
    "backgroundProcess": {
      "owner": "none",
      "jarvosStartsProcess": false
    },
    "preparation": {
      "requiresExactSetup": true,
      "requiresSelectedTuple": true
    },
    "liveProof": {
      "qualifyingEventClasses": [
        "session",
        "turn"
      ],
      "producerEvents": {
        "session": "SessionStart",
        "turn": "UserPromptSubmit"
      },
      "freshnessSeconds": 900,
      "forwardSkewSeconds": 30
    },
    "health": {
      "mayActivate": false,
      "mayExplainDegradation": true
    },
    "rollback": {
      "ownership": "exact-owned",
      "invalidatesGeneration": true,
      "refuseModified": true
    }
  },
  "stewardshipAdapter": {
    "version": "jarvos-stewardship-adapter.v1",
    "harness": "claude-code",
    "isolation": {
      "preferredMode": "native",
      "fallbackMode": "managed-launcher",
      "providesIsolatedWorktrees": true,
      "requiresVerifiedWorktreeEvidence": true
    },
    "activation": {
      "enabledByDefault": false,
      "reason": "Configured managed roots activate the reversible launcher while verified native worktrees remain adopted."
    },
    "bootstrap": {
      "version": "jarvos-stewardship-bootstrap.v1",
      "harness": "claude",
      "rootEnvironment": "JARVOS_STEWARDSHIP_STABLE_ROOT",
      "dispatcher": "jarvos-stewardship-dispatcher",
      "entrypoint": {
        "kind": "dispatcher",
        "path": "jarvos-stewardship-dispatcher"
      },
      "actions": [
        "harness-launch",
        "session-start",
        "session-turn",
        "bridge",
        "provenance-probe",
        "session-precompact"
      ],
      "selectedRuntimeAssets": [
        "runtimes/claude/jarvos-session-start-hook.js",
        "runtimes/claude/jarvos-session-turn-hook.js",
        "runtimes/claude/jarvos-precompact-hook.js"
      ],
      "installedConfig": {
        "inspection": "stable-entrypoint-only",
        "prepare": "reversible",
        "rollback": "exact-owned-state"
      },
      "provenance": {
        "action": "provenance-probe",
        "sideEffectFree": true
      }
    },
    "bridge": {
      "environment": "JARVOS_STEWARDSHIP_BRIDGE_COMMAND",
      "contract": "An executable on PATH accepts one lifecycle capability name and emits a public-safe JSON availability receipt. For nextTurnInput, a pending receipt may contain only a bounded plain-English prompt, 2-3 choices, a listed default, and an opaque correlation identifier; hooks display it without granting authority. Claude resolves private bridge state only through its hook stdin session_id and a session-neutral private mapping root; hooks never preserve or display a private context-file path. Native hooks do not capture arbitrary reply text: the in-session agent verifies an exact listed reply, then invokes `jarvos-stewardship-bridge answer --correlation <correlation> --choice <listed-choice>`, which passes only those two bounded fields."
    },
    "capabilities": {
      "startOrResume": {
        "mode": "native-hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js"
      },
      "heartbeat": {
        "mode": "native-hook",
        "event": "UserPromptSubmit",
        "script": "jarvos-session-turn-hook.js"
      },
      "checkpoint": {
        "mode": "managed-launcher",
        "state": "stable-idle",
        "reason": "Checkpointing remains a managed-launcher responsibility until an enabled bridge is configured."
      },
      "stop": {
        "mode": "managed-launcher",
        "reason": "Stopping remains a managed-launcher responsibility until an enabled bridge is configured."
      },
      "nextTurnInput": {
        "mode": "native-hook",
        "event": "UserPromptSubmit",
        "script": "jarvos-session-turn-hook.js"
      },
      "availability": {
        "mode": "native-hook",
        "script": "jarvos-session-turn-hook.js"
      }
    }
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "paths": [
      "~/.claude/settings.json",
      "~/.claude/CLAUDE.md",
      "~/Library/Application Support/Claude/claude_desktop_config.json"
    ]
  },
  "unsupportedCapabilities": [
    {
      "capability": "claude-desktop-startup-hydration",
      "reason": "Desktop startup context injection is not enabled until an official supported hook surface is verified."
    }
  ],
  "verification": [
    "claude mcp get jarvos",
    "node runtimes/claude/jarvos-session-start-hook.js",
    "node runtimes/claude/jarvos-precompact-hook.js",
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check claude"
  ]
}
