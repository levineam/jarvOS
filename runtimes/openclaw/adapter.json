{
  "schemaVersion": 1,
  "id": "openclaw",
  "displayName": "OpenClaw",
  "capabilityDescriptor": {
    "version": "jarvos-runtime-capability-descriptor.v1", "harness": "openclaw",
    "capabilities": {
      "context": { "currentWork": { "status": "manual", "transport": "workspace adapter", "reason": "This repository ships guidance, not an OpenClaw runtime bridge." }, "recall": { "status": "manual", "transport": "workspace adapter", "reason": "This repository ships guidance, not an OpenClaw runtime bridge." }, "startupHydration": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw startup integration is adapter-owned." } },
      "notes": { "create": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw note actions require a local adapter." }, "read": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw note actions require a local adapter." }, "update": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw note actions require a local adapter." }, "journalLink": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw journal links require a local adapter." } },
      "skills": { "discover": { "status": "manual", "transport": "OpenClaw workspace", "reason": "OpenClaw owns skill discovery." }, "invoke": { "status": "manual", "transport": "OpenClaw workspace", "reason": "OpenClaw owns skill invocation." } },
      "toolAuthorization": { "declare": { "status": "unsupported", "reason": "No public OpenClaw authorization contract is shipped." }, "enforce": { "status": "unsupported", "reason": "OpenClaw owns tool authorization." } },
      "egress": { "declare": { "status": "unsupported", "reason": "No public OpenClaw egress declaration is shipped." }, "enforce": { "status": "unsupported", "reason": "OpenClaw owns egress enforcement." } },
      "session": { "startupHook": { "status": "manual", "transport": "workspace adapter", "reason": "No checked-in OpenClaw hook is shipped." }, "handoff": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw handoff remains adapter-owned." } },
      "inboundDispatch": { "receive": { "status": "unsupported", "reason": "No public OpenClaw inbound dispatch bridge is shipped." }, "validate": { "status": "unsupported", "reason": "No public OpenClaw inbound dispatch bridge is shipped." } },
      "lifecycle": { "receipt": { "status": "manual", "transport": "workspace adapter", "reason": "OpenClaw lifecycle receipts remain adapter-owned." } },
      "scheduledWork": { "participate": { "status": "manual", "transport": "OpenClaw workspace", "reason": "OpenClaw scheduling remains workspace-owned." } },
      "codingEntrypoint": { "invoke": { "status": "unsupported", "reason": "OpenClaw is not declared as a jarvOS coding entrypoint." } }
    }
  },
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate"
    ]
  },
  "targets": [
    {
      "id": "openclaw",
      "kind": "agent-runtime",
      "mcp": {
        "supported": true,
        "transport": "stdio",
        "registration": "Register modules/jarvos-agent-context/scripts/jarvos-mcp.js with the workspace agent configuration."
      },
      "hydration": {
        "mode": "manual",
        "command": "Call the jarvos_hydrate MCP tool at session start.",
        "reason": "This public adapter does not activate a global OpenClaw session hook."
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "stewardshipAdapter": {
    "version": "jarvos-stewardship-adapter.v1",
    "harness": "openclaw",
    "isolation": {
      "preferredMode": "managed-launcher",
      "fallbackMode": "managed-launcher",
      "providesIsolatedWorktrees": true,
      "requiresVerifiedWorktreeEvidence": true
    },
    "activation": {
      "enabledByDefault": false,
      "reason": "Configured managed roots activate the reversible launcher; all other repositories and administrative commands stay on the bound original binary."
    },
    "bootstrap": {
      "version": "jarvos-stewardship-bootstrap.v1",
      "harness": "openclaw",
      "rootEnvironment": "JARVOS_STEWARDSHIP_STABLE_ROOT",
      "dispatcher": "jarvos-stewardship-dispatcher",
      "entrypoint": { "kind": "openclawPlugin", "path": "jarvos-openclaw-stewardship-plugin" },
      "actions": ["harness-launch", "session-start", "session-turn", "bridge", "provenance-probe"],
      "selectedRuntimeAssets": ["runtimes/openclaw/jarvos-next-turn-plugin.js", "runtimes/openclaw/openclaw.plugin.json", "runtimes/openclaw/package.json"],
      "installedConfig": { "inspection": "stable-entrypoint-only", "prepare": "reversible", "rollback": "exact-owned-state" },
      "provenance": { "action": "provenance-probe", "sideEffectFree": true }
    },
    "persistence": {
      "owner": "openclaw-plugin-registry",
      "validation": {
        "command": ["plugins", "inspect", "--all", "--json"],
        "schema": "openclaw-plugin-inspection-array.v1",
        "readOnly": true,
        "activatesPluginCode": false,
        "targetPluginId": "jarvos-stewardship"
      }
    },
    "bridge": {
      "environment": "JARVOS_STEWARDSHIP_BRIDGE_COMMAND",
      "route": "owner-only hashed session mapping",
      "contract": "The managed launcher uses the private bridge environment for lifecycle calls and records only the staged bridge executable and context paths under a SHA-256 key derived from the explicit OpenClaw session key or ID. The separate gateway process uses its own session context to select that exact mapping and may inject only a bounded public-safe judgment receipt."
    },
    "capabilities": {
      "startOrResume": { "mode": "managed-launcher" },
      "heartbeat": { "mode": "managed-launcher" },
      "checkpoint": { "mode": "managed-launcher", "state": "stable-idle" },
      "stop": { "mode": "managed-launcher" },
      "nextTurnInput": { "mode": "native-hook", "event": "agent_turn_prepare", "script": "jarvos-next-turn-plugin.js" },
      "availability": { "mode": "managed-launcher" }
    }
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "transactionalPreserveUnrelatedConfiguration": true,
    "paths": [
      "~/.openclaw/openclaw.json"
    ]
  },
  "unsupportedCapabilities": [],
  "verification": [
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check openclaw"
  ]
}
