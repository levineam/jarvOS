{
  "schemaVersion": 1,
  "id": "codex",
  "displayName": "Codex",
  "capabilityDescriptor": {
    "version": "jarvos-runtime-capability-descriptor.v1", "harness": "codex",
    "capabilities": {
      "context": { "currentWork": { "status": "supported", "transport": "jarvos MCP", "evidence": "sharedAgentContext required tools" }, "recall": { "status": "supported", "transport": "jarvos MCP", "evidence": "sharedAgentContext required tools" }, "startupHydration": { "status": "supported", "transport": "SessionStart hook", "evidence": "jarvos-session-start-hook.js" } },
      "notes": { "create": { "status": "supported", "transport": "jarvos_create_note MCP tool", "evidence": "sharedAgentContext required tools" }, "read": { "status": "unsupported", "reason": "No public Codex note-read bridge is declared." }, "update": { "status": "unsupported", "reason": "No public Codex note-update bridge is declared." }, "journalLink": { "status": "unsupported", "reason": "No public Codex journal-link bridge is declared." } },
      "skills": { "discover": { "status": "manual", "transport": "Codex skills directory", "reason": "Codex owns skill discovery." }, "invoke": { "status": "manual", "transport": "Codex skills directory", "reason": "Codex owns skill invocation." } },
      "toolAuthorization": { "declare": { "status": "manual", "transport": "capability profile", "reason": "The public profile declares but does not install Codex authorization." }, "enforce": { "status": "unsupported", "reason": "No public Codex authorization enforcer is declared." } },
      "egress": { "declare": { "status": "manual", "transport": "capability profile", "reason": "The public profile declares egress but does not configure Codex egress." }, "enforce": { "status": "unsupported", "reason": "No public Codex egress enforcer is declared." } },
      "session": { "startupHook": { "status": "supported", "transport": "SessionStart hook", "evidence": "jarvos-session-start-hook.js" }, "handoff": { "status": "unsupported", "reason": "No public Codex handoff adapter is declared." } },
      "inboundDispatch": { "receive": { "status": "unsupported", "reason": "No public Codex inbound dispatch bridge is declared." }, "validate": { "status": "unsupported", "reason": "No public Codex inbound dispatch bridge is declared." } },
      "lifecycle": { "receipt": { "status": "unsupported", "reason": "No public Codex lifecycle receipt bridge is declared." } },
      "scheduledWork": { "participate": { "status": "unsupported", "reason": "Scheduled work is not part of this public adapter." } },
      "codingEntrypoint": { "invoke": { "status": "supported", "transport": "Codex CLI", "evidence": "public Codex CLI adapter" } }
    }
  },
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate",
      "jarvos_control_plane"
    ]
  },
  "targets": [
    {
      "id": "codex-cli",
      "kind": "cli",
      "mcp": {
        "supported": true,
        "registration": "codex mcp add jarvos -- node <mcp-server>"
      },
      "hydration": {
        "mode": "hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js",
        "defaultMaxChars": 12000
      }
    },
    {
      "id": "codex-app-local",
      "kind": "desktop-local",
      "mcp": {
        "supported": true,
        "registration": "shared ~/.codex/config.toml MCP server"
      },
      "hydration": {
        "mode": "hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js",
        "defaultMaxChars": 12000
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "paths": [
      "~/.codex/config.toml"
    ]
  },
  "unsupportedCapabilities": [],
  "controlPlane": {
    "module": "modules/jarvos-control-plane/scripts/jarvos-manager.js",
    "hostService": "JARVOS_CONTROL_PLANE_SERVICE_MODULE",
    "credentialFile": "JARVOS_CONTROL_PLANE_CREDENTIAL_FILE",
    "parity": "Human CLI and agent MCP delegate to the same installed authenticated application service. Public/minimal setup registers the shared MCP without host bindings; when either host env is set, both absolute non-secret paths are required and verified. Setup never registers the raw credential value; the MCP server reads the secret at runtime."
  },
  "verification": [
    "codex mcp get jarvos",
    "node runtimes/codex/jarvos-session-start-hook.js",
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check codex"
  ]
}
