{
  "schemaVersion": 1,
  "id": "codex",
  "displayName": "Codex",
  "skillProjection": {
    "version": "jarvos-skill-projection-adapter/v1",
    "managedRoot": "~/.codex/skills",
    "orderedScopes": ["project", "user", "managed"],
    "scopeRoots": { "project": "./.codex/skills", "user": "~/.codex/skills" },
    "renderer": "raw-skill-bundle",
    "verificationTier": "exact-path",
    "bundleAllowlist": ["SKILL.md", "scripts/**", "assets/**", "references/**", "templates/**"],
    "alias": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "maxLength": 64, "reservedNames": [] },
    "probeIsolation": { "mode": "receipt-bound-exact-path", "unattended": true }
  },
  "operatorNotification": {
    "version": "jarvos-operator-notification-adapter/v1",
    "contract": "jarvos-operator-notification/v1",
    "delivery": { "status": "not-configured", "reason": "Local owner configuration chooses a delivery surface; this public adapter does not configure one." }
  },
  "capabilityDescriptor": {
    "version": "jarvos-runtime-capability-descriptor.v1", "harness": "codex",
    "capabilities": {
      "context": { "currentWork": { "status": "supported", "transport": "jarvos MCP", "evidence": "sharedAgentContext required tools" }, "recall": { "status": "supported", "transport": "jarvos MCP", "evidence": "sharedAgentContext required tools" }, "startupHydration": { "status": "supported", "transport": "SessionStart hook", "evidence": "jarvos-session-start-hook.js" } },
      "notes": { "create": { "status": "supported", "transport": "jarvos_create_note MCP tool", "evidence": "sharedAgentContext required tools" }, "read": { "status": "unsupported", "reason": "No public Codex note-read bridge is declared." }, "update": { "status": "unsupported", "reason": "No public Codex note-update bridge is declared." }, "journalLink": { "status": "unsupported", "reason": "No public Codex journal-link bridge is declared." } },
      "skills": { "discover": { "status": "manual", "transport": "Codex skills directory", "reason": "Codex owns skill discovery." }, "invoke": { "status": "manual", "transport": "Codex skills directory", "reason": "Codex owns skill invocation." } },
      "toolAuthorization": { "declare": { "status": "manual", "transport": "capability profile", "reason": "The public profile declares but does not install Codex authorization." }, "enforce": { "status": "unsupported", "reason": "No public Codex authorization enforcer is declared." } },
      "egress": { "declare": { "status": "manual", "transport": "capability profile", "reason": "The public profile declares egress but does not configure Codex egress." }, "enforce": { "status": "unsupported", "reason": "No public Codex egress enforcer is declared." } },
      "session": { "startupHook": { "status": "supported", "transport": "SessionStart hook", "evidence": "jarvos-session-start-hook.js" }, "handoff": { "status": "unsupported", "reason": "No public Codex handoff adapter is declared." } },
      "inboundDispatch": { "receive": { "status": "unsupported", "reason": "No public Codex inbound dispatch bridge is declared." }, "validate": { "status": "unsupported", "reason": "No public Codex inbound dispatch bridge is declared." } },
      "lifecycle": { "receipt": { "status": "unsupported", "reason": "No public Codex lifecycle receipt bridge is declared." } },
      "scheduledWork": { "participate": { "status": "unsupported", "reason": "Scheduled work is not part of this public adapter." } },
      "codingEntrypoint": { "invoke": { "status": "supported", "transport": "Codex CLI", "evidence": "public Codex CLI adapter" } }
    }
  },
  "sharedAgentContext": {
    "mcpServer": "modules/jarvos-agent-context/scripts/jarvos-mcp.js",
    "requiredTools": [
      "jarvos_current_work",
      "jarvos_recall",
      "jarvos_create_note",
      "jarvos_startup_brief",
      "jarvos_hydrate",
      "jarvos_control_plane"
    ]
  },
  "targets": [
    {
      "id": "codex-cli",
      "kind": "cli",
      "mcp": {
        "supported": true,
        "registration": "codex mcp add jarvos -- node <mcp-server>"
      },
      "hydration": {
        "mode": "hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js",
        "defaultMaxChars": 12000
      }
    },
    {
      "id": "codex-app-local",
      "kind": "desktop-local",
      "mcp": {
        "supported": true,
        "registration": "shared ~/.codex/config.toml MCP server"
      },
      "hydration": {
        "mode": "hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js",
        "defaultMaxChars": 12000
      }
    }
  ],
  "setup": {
    "script": "setup.sh"
  },
  "managedProviders": {
    "compound-engineering": {
      "status": "supported",
      "manifest": "modules/jarvos-coding/providers/compound-engineering.json",
      "capabilityRecord": "runtimes/codex/compound-engineering-capability.json",
      "conformanceReceipt": "runtimes/codex/compound-engineering-conformance.json",
      "profileBoundary": "CODEX_HOME",
      "activation": "approved-pinned-after-conformance",
      "discovery": "read-only-codex-plugin-marketplace-and-plugin-list",
      "invocation": "codex-exec-bounded-provider-prompt",
      "fallback": "jarvos-native-workflow"
    }
  },
  "managedActivation": {
    "version": "jarvos-managed-activation/v1",
    "harness": "codex",
    "executionOwner": "native-hooks",
    "backgroundProcess": {
      "owner": "none",
      "jarvosStartsProcess": false
    },
    "preparation": {
      "requiresExactSetup": true,
      "requiresSelectedTuple": true
    },
    "liveProof": {
      "qualifyingEventClasses": ["session", "turn"],
      "producerEvents": { "session": "SessionStart", "turn": "UserPromptSubmit" },
      "freshnessSeconds": 900,
      "forwardSkewSeconds": 30
    },
    "health": {
      "mayActivate": false,
      "mayExplainDegradation": true
    },
    "rollback": {
      "ownership": "exact-owned",
      "invalidatesGeneration": true,
      "refuseModified": true
    }
  },
  "stewardshipAdapter": {
    "version": "jarvos-stewardship-adapter.v1",
    "harness": "codex",
    "isolation": {
      "preferredMode": "native",
      "fallbackMode": "managed-launcher",
      "providesIsolatedWorktrees": true,
      "requiresVerifiedWorktreeEvidence": true
    },
    "activation": {
      "enabledByDefault": false,
      "reason": "Configured managed roots activate the reversible launcher while verified native worktrees remain adopted."
    },
    "bootstrap": {
      "version": "jarvos-stewardship-bootstrap.v1",
      "harness": "codex",
      "rootEnvironment": "JARVOS_STEWARDSHIP_STABLE_ROOT",
      "dispatcher": "jarvos-stewardship-dispatcher",
      "entrypoint": { "kind": "dispatcher", "path": "jarvos-stewardship-dispatcher" },
      "actions": ["harness-launch", "session-start", "session-turn", "bridge", "provenance-probe"],
      "selectedRuntimeAssets": ["runtimes/codex/jarvos-session-start-hook.js", "runtimes/codex/jarvos-session-turn-hook.js"],
      "installedConfig": { "inspection": "stable-entrypoint-only", "prepare": "reversible", "rollback": "exact-owned-state" },
      "provenance": { "action": "provenance-probe", "sideEffectFree": true }
    },
    "bridge": {
      "environment": "JARVOS_STEWARDSHIP_BRIDGE_COMMAND",
      "contract": "An executable on PATH accepts one lifecycle capability name and emits a public-safe JSON availability receipt. For nextTurnInput, a pending receipt may contain only a bounded plain-English prompt, 2-3 choices, a listed default, and an opaque correlation identifier; hooks display it without granting authority. Codex resolves private bridge state only through the current CODEX_THREAD_ID and a session-neutral private mapping root. Native hooks do not capture arbitrary reply text: the in-session agent verifies an exact listed reply, then invokes `jarvos-stewardship-bridge answer --correlation <correlation> --choice <listed-choice>`, which passes only those two bounded fields."
    },
    "capabilities": {
      "startOrResume": {
        "mode": "native-hook",
        "event": "SessionStart",
        "script": "jarvos-session-start-hook.js"
      },
      "heartbeat": {
        "mode": "native-hook",
        "event": "UserPromptSubmit",
        "script": "jarvos-session-turn-hook.js"
      },
      "checkpoint": {
        "mode": "managed-launcher",
        "state": "stable-idle",
        "reason": "Codex does not use a stable-idle lifecycle hook for this adapter."
      },
      "stop": {
        "mode": "managed-launcher",
        "reason": "Codex stop handling remains a managed-launcher responsibility."
      },
      "nextTurnInput": {
        "mode": "native-hook",
        "event": "UserPromptSubmit",
        "script": "jarvos-session-turn-hook.js"
      },
      "availability": {
        "mode": "native-hook",
        "script": "jarvos-session-turn-hook.js"
      }
    }
  },
  "configWrites": {
    "backupBeforeWrite": true,
    "paths": [
      "~/.codex/config.toml"
    ]
  },
  "unsupportedCapabilities": [],
  "controlPlane": {
    "module": "modules/jarvos-control-plane/scripts/jarvos-manager.js",
    "hostService": "JARVOS_CONTROL_PLANE_SERVICE_MODULE",
    "credentialFile": "JARVOS_CONTROL_PLANE_CREDENTIAL_FILE",
    "parity": "Human CLI and agent MCP delegate to the same installed authenticated application service. Public/minimal setup registers the shared MCP without host bindings; when either host env is set, both absolute non-secret paths are required and verified. Setup never registers the raw credential value; the MCP server reads the secret at runtime."
  },
  "verification": [
    "codex mcp get jarvos",
    "node runtimes/codex/jarvos-session-start-hook.js",
    "node modules/jarvos-runtime-kit/scripts/jarvos-runtime-kit.js check codex"
  ]
}
